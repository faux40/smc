APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local default is verbose. Production should use LOG_CHANNEL=daily (rotating,
# 14-day) with LOG_LEVEL=info or warning — debug logs are noisy and can leak
# request detail. See docs/DEPLOYMENT.md.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smc
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime is core to this app — use the `reverb` broadcaster. Broadcasts are
# queued (ShouldBroadcast), so a queue worker must be running to deliver them
# (locally `composer dev` runs queue:listen; production uses redis + a
# queue:work daemon — see docs/DEPLOYMENT.md).
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Local default; production uses `redis` (with a queue:work daemon).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Phase 15.4 — master switch for the `mail` channel on per-user
# notifications. Off by default; the in-app inbox + realtime bell
# always deliver regardless.
MAIL_NOTIFICATIONS_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Linode Object Storage (S3-compatible) — backs the `linode` disk used for
# attachments (AttachmentsController). Required for file uploads to work.
LINODE_ACCESS_KEY=
LINODE_SECRET_KEY=
LINODE_REGION=
LINODE_BUCKET=
LINODE_URL=
LINODE_ENDPOINT=
LINODE_PATH_STYLE=true

# Laravel Reverb (WebSocket server). The REVERB_* keys configure the server;
# the VITE_REVERB_* keys are read by the browser client (echo.ts) and are
# BAKED INTO THE JS BUNDLE AT BUILD TIME — changing them requires a fresh
# `npm run build`, not just a config change. See docs/DEPLOYMENT.md.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Multi-host: set true + a shared redis channel so broadcasts fan out across
# app servers (a single Reverb host doesn't need this).
REVERB_SCALING_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
