# Laravel loads this file (instead of .env) when APP_ENV=testing — see
# Application::checkForSpecificEnvironmentFile. The phpunit.xml <env>
# entries also set these via putenv() for belt-and-suspenders, but
# having a real .env.testing avoids the dotenv-precedence trap that
# wiped the real DB once already (2026-05-18).

APP_NAME="Salt Mine Compliance (testing)"
APP_ENV=testing
APP_KEY=base64:42qs+DoAVA6FXJt4U+bBtBajfZf8tE+rEQIKL8TE4j8=
APP_DEBUG=true
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# In-memory SQLite — RefreshDatabase / migrate:fresh against this is
# safe. NEVER point this at a real DB.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array

# Reverb keys still need to be set so the broadcaster can construct;
# `null` driver above means nothing actually publishes.
REVERB_APP_ID=testing
REVERB_APP_KEY=testing
REVERB_APP_SECRET=testing
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
